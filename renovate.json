{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":gitSignOff"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardHeader": "Project settings are at https://developer.mend.io/",
  "labels": [
    "changelog:dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "changelog:dependencies"
    ],
    "minimumReleaseAge": "0 days"
  },
  "suppressNotifications": [
    "prEditedNotification"
  ],
  "schedule": [
    "on the first day of the month"
  ],
  "packageRules": [
    {
      "description": "A version pinned under fixture/, harness/ or records/ is part of the recorded setup of an experiment, and a change to it makes new results incomparable with the published ones. Only a deliberate change may move such a pin.",
      "matchFileNames": [
        "fixture/**",
        "harness/**",
        "records/**"
      ],
      "enabled": false
    }
  ]
}
